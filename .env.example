# Copy to .env next to docker-compose.yml and adjust. All values are optional.

# Host port the web UI is published on.
PORT=8080

# Host directories mounted into the container.
DATA_DIR=./data          # database, settings and the GOG refresh token
LIBRARY_DIR=./library    # downloaded installers, one folder per game

# UID/GID the container runs as; use the owner of LIBRARY_DIR so files are writable.
PUID=1000
PGID=1000

# Timezone for log timestamps, as a tz database name such as Europe/Oslo or America/New_York.
# Full list: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TZ=UTC

# debug, info, warn or error
LOG_LEVEL=info

# Set to 1 to explore the UI with a fake library and no GOG account.
MOCK_GOG=0
